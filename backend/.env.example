# =========================================================================
# Skylark BI Agent — environment configuration
# Copy this file to `.env` and fill in the real values. NEVER commit `.env`.
# =========================================================================

# --- Monday.com (read-only at runtime; write access needed once for ingestion) ---
# Personal API token from: monday.com -> avatar -> Developers -> My Access Tokens
MONDAY_API_TOKEN=
MONDAY_API_URL=https://api.monday.com/v2

# Board IDs are written automatically by scripts/ingest_to_monday.py into
# backend/app/board_config.json. You normally do NOT set these by hand.
# Left here only as an optional override.
# DEALS_BOARD_ID=
# WORK_ORDERS_BOARD_ID=

# --- LLM (provider abstraction) ---
# LLM_PROVIDER selects the backend for natural-language intent + narration:
#   none      -> deterministic keyword parser + template narration (ALWAYS FREE,
#                no key needed). This is the default so the hosted app is never a
#                paid dependency — anyone testing it cannot trigger billing.
#   groq      -> Groq free tier (no credit card). Get a key at console.groq.com.
#   anthropic -> Anthropic (PAID; requires purchased credits).
LLM_PROVIDER=none

# Groq (free tier) — only needed if LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Anthropic (paid) — only used if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Runtime tuning ---
# Seconds to cache Monday board data in memory (avoids hammering the API).
CACHE_TTL_SECONDS=300
# Port the server binds to (Render injects PORT automatically).
PORT=8000
